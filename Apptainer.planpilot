# Stage 1: Build the planner and the fasb Python bindings
Bootstrap: docker
From: ubuntu:26.04
Stage: build

%files
    . tools/

%post
    export DEBIAN_FRONTEND=noninteractive

    ## Install all necessary dependencies.
    ## (planpilot requires Python >= 3.12; Ubuntu 26.04 ships 3.14.
    ##  fasb uses Rust edition 2024, which requires rustc >= 1.85.)
    apt-get update
    apt-get -y install --no-install-recommends \
        ca-certificates curl build-essential cmake \
        rustc cargo \
        python3 python3-dev

    ## uv for building the Python environment
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"

    ## Remove unneeded folders, and artifacts from the build host
    rm -rf /tools/benchmarks/ /tools/experiments/ /tools/__pycache__/ /tools/.venv/ \
        /tools/fasb-subtree/target/ /tools/output.sas /tools/instance.lp

    ## Create the virtual environment and compile the fasb Python bindings
    ## (this builds the Rust crate in /tools/fasb-subtree, including the
    ##  clingo solver embedded via the savan library)
    cd /tools
    uv sync --python python3

# Stage 2: Run the planner
Bootstrap: docker
From: ubuntu:26.04
Stage: run

%files from build
    /tools/.venv/ /tools/.venv/
    /tools/encodings/ /tools/encodings/
    /tools/bin/plasp /tools/bin/plasp
    /tools/utils.py /tools/utils.py
    /tools/planpilot.py /tools/planpilot.py
    /tools/scripts/ /tools/scripts/
    /tools/translate/ /tools/translate/

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get -y install --no-install-recommends python3
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/tools/:$PATH

%runscript
    #!/bin/bash

    set -euo pipefail

    /tools/.venv/bin/python /tools/planpilot.py "$@"
